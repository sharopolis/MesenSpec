<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:cfg="using:Mesen.Config"
	xmlns:c="using:Mesen.Controls"
	xmlns:dc="using:Mesen.Debugger.Controls"
	mc:Ignorable="d"
  Design.Width="200"
  Design.Height="600"
	VerticalAlignment="Stretch"
	HorizontalAlignment="Stretch"
	x:DataType="cfg:ZxEventViewerConfig"
	x:Class="Mesen.Debugger.Views.ZxEventViewerConfigView"
>
	<Design.DataContext>
		<cfg:ZxEventViewerConfig />
	</Design.DataContext>

	<StackPanel>
		<Grid ColumnDefinitions="10, 1*, 10, 1*" RowDefinitions="Auto,Auto">
			<c:OptionSection Header="Port writes" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0" />
			<c:OptionSection Header="Port reads" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"  Margin="10 0 0 0" />
			<StackPanel Grid.Column="1" Grid.Row="1">
				<dc:EventViewerCategoryControl Text="ULA (border/beeper)" Config="{Binding UlaPortWrite}" />
				<dc:EventViewerCategoryControl Text="Other ports" Config="{Binding OtherPortWrite}" />
			</StackPanel>
			<StackPanel Grid.Column="3" Grid.Row="1">
				<dc:EventViewerCategoryControl Text="ULA (keyboard/EAR)" Config="{Binding UlaPortRead}" />
				<dc:EventViewerCategoryControl Text="Other ports" Config="{Binding OtherPortRead}" />
			</StackPanel>
		</Grid>

		<c:OptionSection Header="Memory" />
		<StackPanel>
			<dc:EventViewerCategoryControl Text="Screen writes ($4000-$5AFF)" Config="{Binding ScreenWrite}" />
		</StackPanel>

		<c:OptionSection Header="Other events" />
		<StackPanel>
			<dc:EventViewerCategoryControl Text="IRQ" Config="{Binding Irq}" />
			<dc:EventViewerCategoryControl Text="NMI" Config="{Binding Nmi}" />
			<dc:EventViewerCategoryControl Text="Marked Breakpoints" Config="{Binding MarkedBreakpoints}" />
		</StackPanel>

		<CheckBox Margin="0 10 0 0" IsChecked="{Binding ShowPreviousFrameEvents}" Content="Show previous frame events" />
	</StackPanel>
</UserControl>
